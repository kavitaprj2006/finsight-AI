# FinSight AI Environment Configuration

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Market & Currency Defaults
DEFAULT_MARKET=IN
DEFAULT_CURRENCY=INR

# Market Data Provider API Keys
# Financial Modeling Prep (FMP) - https://site.financialmodelingprep.com/
FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage - https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=your_alphavantage_api_key_here

# Database Configuration
# Default fallback uses local SQLite database if PostgreSQL is not available
DATABASE_URL=sqlite:///data/finsight.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/finsight

# MLflow Tracking
MLFLOW_TRACKING_URI=file:./mlruns

# Cache Settings
CACHE_TTL_SECONDS=3600
OFFLINE_MODE=false
